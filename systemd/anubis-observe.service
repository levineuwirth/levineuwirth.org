[Unit]
Description=Preserve crawl evidence and sample Anubis counters
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/bin/anubis-observe.py
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/anubis-observations
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
