# Environment for vps-config-backup.service. Copy to /etc/default/vps-config-backup
# (root, 0600). systemd parses it: one KEY=value per line, no shell.

#DEST=/root/vps-config-backups
#KEEP=14

# Off-host through borg, same repository and key as the other backups;
# archives are config-<TS>, pruned separately. Unset BORG_REPO = local only.
BORG_REPO=ssh://storagebox/./backup/vps
BORG_PASSCOMMAND=cat /etc/borg/passphrase
BORG_RSH=ssh -i /root/.ssh/id_storagebox -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=4
#OFFHOST_PRUNE=--keep-within 7d --keep-daily 14 --keep-weekly 8 --keep-monthly 12
