[Unit]
Description=Nightly Anki sync server backup

[Timer]
# 03:45 UTC, before anyone in Europe is awake to sync. The window overlaps
# the Forgejo (03:30 + 20 min), CouchDB (03:15 + 10 min) and config
# (04:00 + 10 min) backups, and all four upload to one borg repository;
# borg-offhost.sh waits for the repository lock (BORG_LOCK_WAIT) rather
# than failing the later job. The 04:30 upgrade shares a lock with this
# job (anki-sync-backup.service).
OnCalendar=*-*-* 03:45
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
