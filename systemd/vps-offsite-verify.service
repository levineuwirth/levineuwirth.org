# Monthly proof that the off-host backups restore: borg check on the
# repository, then the newest Forgejo, Anki, CouchDB and host-configuration
# archives extracted from it and verified — checksum, then the same integrity
# checks the local --verify runs (CouchDB's restores into a scratch
# container, so this unit now depends on docker too). Fails loudly in the
# journal; tools/vps-status reads it.
#
#   scp systemd/vps-offsite-verify.{service,timer} root@<vps>:/etc/systemd/system/
#   ssh root@<vps> systemctl daemon-reload && systemctl enable --now vps-offsite-verify.timer

[Unit]
Description=Off-host backup verification (borg check + restore test)
Documentation=https://git.levineuwirth.org/neuwirth/levineuwirth.org
# network-online: borg reaches the storage box over ssh, and Persistent=
# fires a missed run right at boot (audit Y07).
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/anki-sync-backup
ExecStart=/usr/local/bin/vps-offsite-verify.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
# scratch on disk: /tmp is a RAM tmpfs and the restore tests extract gigabytes
Environment=TMPDIR=/var/tmp
