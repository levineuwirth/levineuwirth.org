# Nightly archive of the LeVCS instance's repositories
# (tools/levcs-instance-backup.sh). It drives LeVCS's own levcs-backup and
# levcs-restore, and its levcs, from /usr/local/bin, where LeVCS's
# deploy/README.md installs them.
#
#   scp tools/levcs-instance-backup.sh root@<vps>:/usr/local/bin/ && ssh root@<vps> chmod 755 /usr/local/bin/levcs-instance-backup.sh
#   scp systemd/levcs-instance-backup{,-verify}.{service,timer} root@<vps>:/etc/systemd/system/
#   scp systemd/levcs-instance-backup.env.example root@<vps>:/etc/default/levcs-instance-backup   (then edit, chmod 600)
#   ssh root@<vps> systemctl daemon-reload && systemctl enable --now levcs-instance-backup.timer levcs-instance-backup-verify.timer

[Unit]
Description=LeVCS instance backup (levcs-backup with the instance stopped, then a scratch restore)
Documentation=https://git.levineuwirth.org/neuwirth/levineuwirth.org
# network-online: borg reaches the storage box over ssh, and Persistent=
# fires a missed run right at boot (audit Y07).
After=levcs-instance.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/levcs-instance-backup
ExecStart=/usr/local/bin/levcs-instance-backup.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=45min
Environment=TMPDIR=/var/tmp
