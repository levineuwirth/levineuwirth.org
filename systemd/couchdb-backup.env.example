# Environment for couchdb-backup.service and couchdb-backup-verify.service.
# Copy to /etc/default/couchdb-backup (root, 0600). systemd parses it: one
# KEY=value per line, no shell.
#
#   scp systemd/couchdb-backup.env.example root@<vps>:/etc/default/couchdb-backup
#   ssh root@<vps> chmod 600 /etc/default/couchdb-backup
#   ssh root@<vps> $EDITOR /etc/default/couchdb-backup

# CouchDB admin credentials — same values as couchdb/server.env on the box,
# duplicated here because a different unit reads this file.
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE

#COUCHDB_URL=http://127.0.0.1:5984
#DEST=/root/couchdb-backups
#KEEP=14
#DBS=universum apocrypha
# --verify only; by default the image the running `couchdb` container uses.
# (A comment must have a line of its own: systemd reads a trailing `# …`
# as part of the value.)
#COUCHDB_IMAGE=couchdb:3

# Off-host through borg, same repository and key as the Forgejo/Anki
# backups; archives are couchdb-<TS>, pruned separately. Unset BORG_REPO =
# local only.
BORG_REPO=ssh://storagebox/./backup/vps
BORG_PASSCOMMAND=cat /etc/borg/passphrase
BORG_RSH=ssh -i /root/.ssh/id_storagebox -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=4
#OFFHOST_PRUNE=--keep-within 7d --keep-daily 14 --keep-weekly 8 --keep-monthly 12
