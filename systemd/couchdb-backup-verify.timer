# Weekly trigger for couchdb-backup-verify.service. See that unit's header
# for the reasoning and couchdb-backup.service for the install commands.

[Unit]
Description=Weekly CouchDB backup verification

[Timer]
# Sunday 04:45 UTC + up to 10 min. Forgejo's verify is 04:30 + up to
# 20 min, so it can start as late as 04:50, possibly after this one: the
# two docker-heavy restore tests can overlap, in either order. Neither
# takes a lock the other needs.
OnCalendar=Sun *-*-* 04:45
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
