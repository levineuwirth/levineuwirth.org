# Weekly trigger for couchdb-backup-verify.service. See that unit's header
# for the reasoning and couchdb-backup.service for the install commands.

[Unit]
Description=Weekly CouchDB backup verification

[Timer]
# Sunday 04:45 UTC, after Forgejo's verify starts (04:30, but with up to
# 20 min of random delay it can start as late as 04:50, so the two
# docker-heavy restore tests can still overlap; neither takes a lock the
# other needs).
OnCalendar=Sun *-*-* 04:45
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
