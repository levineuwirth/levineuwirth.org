# Environment for anki-sync-backup.service. Copy to /etc/default/anki-sync-backup
# (root, 0600). systemd parses it: one KEY=value per line, no shell.

# Where the sync server keeps its data (SYNC_BASE of anki-sync.service).
SYNC_BASE=/var/lib/anki-sync
#DEST=/root/anki-sync-backups
#KEEP=7

# Off-host through borg, same repository and key as the Forgejo backup;
# archives are anki-<TS>, pruned separately. Unset BORG_REPO = local only.
BORG_REPO=ssh://storagebox/./backup/vps
BORG_PASSCOMMAND=cat /etc/borg/passphrase
BORG_RSH=ssh -i /root/.ssh/id_storagebox -o BatchMode=yes
#OFFHOST_PRUNE=--keep-daily 14 --keep-weekly 8 --keep-monthly 12
