# /root/couchdb-server/server.env — read by couchdb/docker-compose.yml.
# SECRET: chmod 600, never committed.
#
# Admin credentials, used only for the one-time setup (creating the
# universum/apocrypha databases and their scoped per-database users) and
# by couchdb-backup.sh. No device's LiveSync plugin config ever holds
# these — each vault gets its own non-admin user instead.
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE
