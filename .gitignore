dist-newstyle/
_site/
_cache/
# Dev builds (make dev / make watch) write here instead (audit D06).
_site-dev/
_cache-dev/
.DS_Store
.env
# Defense-in-depth: the auto-snapshot in `make build` stages content/
# wholesale. These patterns prevent any stray credential-shaped file
# (dropped accidentally during writing) from being staged + pushed.
# To intentionally commit one of these (rare), use `git add -f`.
**/.env*
**/*.env
# .env.example is documentation (tracked), not a credential file — the
# patterns above would otherwise shadow it for status/add purposes.
!.env.example
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
**/.netrc
**/.npmrc
**/.pypirc
**/credentials*
# The rest of what build/Site.hs `neverPublish` and tools/check-site.py
# refuse to publish. Without these the content/ snapshot committed (and
# `make deploy` pushed) what the site itself would never serve: a
# foo.draft.md beside an essay, credentials-2025.csv, interrupted writes
# (audit D03). tests/test_gitignore.py keeps the three lists in step.
**/*.draft.*
**/*.local.html
**/*.tmp
**/*.tmp.*
**/*.part
**/*.partial
**/*.log

# Editor backup/swap files
*~
*.swp
*.swo

# Python bytecode caches, and uv's environment (uv also writes its own
# .gitignore inside it; this does not rely on that).
**/__pycache__/
*.pyc
*.pyo
/.venv/

# No LaTeX globs: the only TeX built here is the CV, whose artifacts stay in
# yaml-source/build/ (below), and the manuscripts live in their own
# repositories. A sitewide *.out or *.toc would also hide an essay's data
# file from the content snapshot while the site still published it.

# Data files that are generated at build time (not version-controlled)
data/similar-links.json
data/footer/
data/build-start.txt
data/build-stamp.txt
data/last-build-seconds.txt
# Build-freshness state (tools/build-freshness.sh): which rules/commit
# the last build used and when the last full rebuild happened
data/rules-hash.txt
data/unpublished-hash.txt
data/last-build-commit.txt
data/last-full-rebuild.txt
data/.full-rebuild-pending
# Build mutex (tools/with-lock.sh) — a flock file that exists only while a
# build is in flight; it is machine state, never a build input.
data/.site-build.lock
# Content-addressed compression sidecars (tools/compress-assets.sh).
data/.compress-cache/
# Stage 2's start time, for the Stage 3 skip (Makefile).
data/.embed-start
# Written only by `make deploy ALLOW_DIRTY_DEPLOY=1`, recording which build
# inputs differed from HEAD at deploy time. Local forensics; never shipped,
# and committing it would defeat the point of the clean-tree guard.
data/last-deploy-dirty.txt
data/semantic-index.bin
data/semantic-meta.json
# Both embed caches (pages + paragraphs); the trailing glob also
# catches interrupted-write debris (.tmp / .tmp.npz)
data/embed-cache-*

# Archive: generated text + its staleness stamp (recreated from the
# committed artifact on every build — deterministic, so committing them is
# churn). archive/**/PROVENANCE.json is deliberately NOT ignored — it is
# the committed, immutable record of each archival event.
archive/**/*.txt
archive/**/*.txt.sha256
data/archive-index.json
data/archive-state.json

# IGNORE.txt is for the local build and need not be synced.
/IGNORE.txt

# Drafts, and planning checklists at any depth (tools/check-site.py and
# tools/code-refs.py treat the name as private wherever it appears).
content/drafts/
checklist.md

# CV/résumé build pipeline (YAML → Jinja → xelatex). The canonical PDFs
# live under static/ and ship with the site. The pipeline *source* is
# tracked: data/ is the single source of truth for both documents (and is
# read by the site build to render the vita page), and templates/ +
# build.py are what regenerate them. Only artifacts stay local.
yaml-source/build/
yaml-source/output/
# Application/company-specific audience metadata stays local. The resolver
# discovers YAML here, but Git does not track or publish it by default.
yaml-source/variants/private/
# Variants stay local until deliberately added: an untracked variant is
# work in progress or application-specific, and deploy-preflight refuses
# untracked files under yaml-source/. Variants already tracked are
# unaffected; publish a new one with `git add -f`.
yaml-source/variants/*.yml

# Model files for client-side semantic search (~22 MB binary artifacts).
# Download with: make download-model
static/models/

# Vendored PDF.js viewer (~18 MB uncompressed, pinned in tools/download-pdfjs.sh).
# Download with: make download-pdfjs
static/pdfjs/

# Vendored Leaflet + leaflet.markercluster (~150 KB total, pinned in
# tools/download-leaflet.sh). Used by the /photography/map/ page only.
# Download with: make download-leaflet (runs as part of `make build`).
static/leaflet/

# Generated WebP companions (produced by tools/convert-images.sh at build time).
# To intentionally commit a WebP, use: git add -f path/to/file.webp
static/**/*.webp
content/**/*.webp

# Photography sidecars (produced by tools/extract-exif.py and
# tools/extract-palette.py at build time; consumed by Hakyll). Recreated
# from the photo file on every `make build`, so they don't belong in
# version control — committing them would just produce churn.
content/photography/**/*.exif.yaml
content/photography/**/*.palette.yaml

# Image-dimension sidecars (produced by tools/extract-dimensions.py at
# build time; consumed by build/Filters/Images.hs to emit width / height
# attrs on every <img> for CLS prevention). Same churn-avoidance reasons
# as the photography sidecars above; recreated on every `make build`.
**/*.dims.yaml

# Photography delivery images.
#
# PHOTOGRAPHY.md originally kept web-optimized JPEGs in the repo and excluded
# only the originals. That reversed in August 2026: 64 frames added 45 MB
# against a 28 MB .git, and the trajectory was clear. They are derived
# artifacts — tools/import-photo.sh regenerates them from the originals — so
# git carries the .md entries and the deployed site carries the pixels, via
# `make deploy`'s rsync of _site/.
#
# Consequence, stated plainly: a fresh clone builds with missing images, and
# the originals under ~/Photos are now load-bearing for the whole section.
# (.webp companions are already covered by content/**/*.webp above.)
content/photography/**/*.jpg
content/photography/**/*.jpeg
content/photography/**/*.png

# Composition score pages — the same policy as the photography delivery
# images above, decided September 2026. They are exported from the
# engraver's source (~/Documents/Scores) by tools/music-import.py: a
# 145-page orchestral score is ~80 MB of SVG and ~9 MB in git, and every
# re-export would add that again. Each piece's score-source.yaml is
# committed and records how to regenerate them
# (`tools/music-import.py refresh`); a fresh clone builds without them.
# Excerpts quoted in the programme notes live in <slug>/excerpts/ and are
# versioned like any other figure.
content/music/*/scores/
# tools/music-import.py assembles an import here before swapping it in.
/.music-import/

# Defense-in-depth — refuse to commit RAW or oversize originals, which were
# never meant to be here even when the delivery JPEGs were. To intentionally
# commit one of these formats (rare), use `git add -f path/to/file`.
content/photography/**/*.cr2
content/photography/**/*.cr3
content/photography/**/*.nef
content/photography/**/*.arw
content/photography/**/*.dng
content/photography/**/*.raf
content/photography/**/*.orf
content/photography/**/*.tif
content/photography/**/*.tiff
content/photography/**/*.psd
# Claude Code local settings — machine-specific, and this repo mirrors
# to a public GitHub remote.
.claude/settings.local.json

# Private working notes — interview briefs, strategy docs, drafts with
# confidential context. The suffix is the signal; no specific filename is
# named here, so this pattern is safe to publish in a public repo.
*.local.md

# The September audit report. Describes server-side configuration, log
# paths, and operational internals; this repo mirrors to public remotes, so
# the report stays local (later reports are *.local.md). Anchored so it
# matches only the file at the repository root, and named explicitly
# because `*.local.md` above does not cover it.
/local.md

# Local agent instructions (AGENTS.md, and CLAUDE.md, which mirrors it).
# They describe the author's machines and vaults, not the site.
/AGENTS.md
/CLAUDE.md

# Build profiles from tools/profile-build.py: local measurements, never published.
.build-profiles/
