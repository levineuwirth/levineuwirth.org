%% ATS-optimized résumé layout.
%%
%% The legacy resume-ats profile keeps its historical rendering below. Generic
%% section-driven variants use the compact branch: still single-column and
%% conventional, but with a deliberate one-page budget.

((* if variant_sections *))
\documentclass[10pt]{extarticle}
((* else *))
\documentclass[11pt]{article}
((* endif *))

\input{templates/shared/preamble.tex}

((* if variant_sections *))
\geometry{
  letterpaper,
  top=0.5in,
  bottom=0.5in,
  left=0.65in,
  right=0.65in
}
((* else *))
\geometry{
  letterpaper,
  top=1in,
  bottom=1in,
  left=1in,
  right=1in
}
((* endif *))

\input{templates/shared/commands.tex}

\RaggedRight

((* if variant_sections *))
% Avoid discretionary-hyphen fragments in the extracted ATS text layer while
% leaving enough emergency stretch for clean ragged-right line endings.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\setlength{\emergencystretch}{1.5em}
\titlespacing*{\section}{0pt}{0.42em}{0.12em}
\setlist[itemize]{
  leftmargin=1.15em,
  topsep=0.04em,
  itemsep=0.06em,
  parsep=0pt,
  label={\small\textbullet}
}
\setlength{\parskip}{0.08em}
\pagestyle{empty}

% Conventional ATS entry header: organization/role, then dates/location.
\renewcommand{\entryheader}[4]{%
  \noindent
  \textbf{#1}\ifx&#2&\else~---~\textit{#2}\fi%
  \par
  \vspace{-0.18em}%
  {\small #3\ifx&#4&\else~\textperiodcentered~#4\fi}%
  \par\vspace{0.04em}%
}

((* macro daterange(record) -*))
(((record.start)))((* if record.end *)) -- (((record.end)))((* endif *))
((*- endmacro *))

((* macro recordlinks(record) *))
((* if record.links *))
{\small
((* for link in record.links *))
\href{(((link.href)))}{(((link.label)))}((* if not loop.last *))
\ \textperiodcentered\ ((* endif *))
((* endfor *))
}\par
((* endif *))
((* endmacro *))

((* macro experience(record) *))
\entryheader{(((record.organization)))}{(((record.role or '')))}{(((daterange(record))))}{(((record.location or '')))}
((* if record.scope *))(((record.scope)))\par((* endif *))
((* if record.description *))(((record.description)))\par((* endif *))
((* if record.bullets and record.bullets|length == 1 *))
(((record.bullets[0])))\par
((* elif record.bullets *))
\begin{itemize}
((* for bullet in record.bullets *))
  \item (((bullet)))
((* endfor *))
\end{itemize}
((* endif *))
(((recordlinks(record))))
\vspace{0.08em}
((* endmacro *))

((* macro project(record) *))
\begin{samepage}
\noindent\textbf{(((record.presentation_label or record.name)))}
\textit{(((daterange(record))))}.
(((record.short_summary or record.summary or record.description)))
\par\vspace{0.12em}
\end{samepage}
((* endmacro *))

((* macro education(record) *))
\entryheader{(((record.institution)))}{(((record.degree)))}{(((daterange(record))))}{(((record.location or '')))}
((* if record.gpa *)){\small GPA (((record.gpa))).}((* endif *))
((* if record.notes *)){\small (((record.notes))) }((* endif *))
\vspace{0.02em}
((* endmacro *))

((* macro skill(record) *))
\noindent\textbf{(((record.presentation_label or record.label))):}
(((record['items'] | join(', ')))).\par\vspace{0.01em}
((* endmacro *))
((* else *))
% Conventional section spacing — not tight, not loose. ATS parsers are
% sensitive to unusual vertical rhythm; stick close to article defaults.
\titlespacing*{\section}{0pt}{0.8em}{0.3em}
\setlist[itemize]{
  leftmargin=1.2em,
  topsep=0.25em,
  itemsep=0.2em,
  parsep=0pt,
  label={\small\textbullet}
}
\setlength{\parskip}{0.3em}

% Entryheader for ATS: organization/role on one line, date/location on
% the next. Plain black text (no metagray) because some ATS grayscale
% conversions mangle low-contrast text.
\renewcommand{\entryheader}[4]{%
  \noindent
  \textbf{#1}\ifx&#2&\else~---~\textit{#2}\fi%
  \par
  \vspace{-0.15em}%
  {\small #3\ifx&#4&\else~\textperiodcentered~#4\fi}%
  \par\vspace{0.2em}%
}
((* endif *))

\begin{document}

((* if variant_sections *))
%% GENERIC SECTION-DRIVEN ATS PROFILE
\begin{center}
  {\headerfont\Large\bfseries (((personal.name)))}\\[0.12em]
  ((* if variant.document_title *))
  {\headerfont\small\MakeUppercase{(((variant.document_title)))}}\\[0.18em]
  ((* endif *))
  {\small
    \href{mailto:(((personal.email)))}{(((personal.email)))}
    \ \textperiodcentered\ (((personal.phone)))
    \ \textperiodcentered\ \href{(((personal.website_url)))}{(((personal.website)))}
    ((* for link in variant.header_links *))
    \ \textperiodcentered\ \href{(((link.href)))}{(((link.label)))}
    ((* endfor *))
  }
\end{center}

((* if variant.summary *))
\vspace{0.05em}
{\small (((variant.summary)))}\par
((* endif *))

((* for section in variant_sections if section.entries *))
\section*{(((section.label)))}
((* for entry in section.entries *))
((* if entry.collection == 'experience' *))
(((experience(entry.record))))
((* elif entry.collection == 'projects' *))
(((project(entry.record))))
((* elif entry.collection == 'education' *))
(((education(entry.record))))
((* elif entry.collection == 'skills' *))
(((skill(entry.record))))
((* endif *))
((* endfor *))
((* endfor *))
((* else *))
%% LEGACY ATS PROFILE
%% HEADER
\begin{center}
  {\headerfont\Large\bfseries (((personal.name)))}\\[0.25em]
  {\small
    \href{mailto:(((personal.email)))}{(((personal.email)))}
    \ \textperiodcentered\
    (((personal.phone)))
    \ \textperiodcentered\
    \href{(((personal.website_url)))}{(((personal.website)))}
    ((* for link in personal.links if link.resume_visible *))
    \ \textperiodcentered\
    \href{(((link.href)))}{(((link.label)))}
    ((* endfor *))
  }
\end{center}

\vspace{0.3em}

%% SUMMARY
\section*{Summary}

(((variant.summary)))

%% WORK EXPERIENCE
\section*{Work Experience}

((* for exp in (experience | selectattr('resume_visible') | sort(attribute='resume_order') | list) *))
\entryheader{(((exp.organization)))}{(((exp.role)))}{(((exp.start)))((* if exp.end *)) -- (((exp.end)))((* endif *))}{(((exp.location or '')))}
((* if exp.scope *))
(((exp.scope)))
\par\vspace{0.1em}
((* endif *))
((* if not exp.bullets *))
((* elif exp.bullets|length == 1 *))
(((exp.bullets[0])))
\par
((* else *))
\begin{itemize}
((* for bullet in exp.bullets *))
  \item (((bullet)))
((* endfor *))
\end{itemize}
((* endif *))
\vspace{0.3em}
((* endfor *))

%% PROJECTS
\section*{Projects}

((* for proj in (projects | selectattr('resume_visible') | sort(attribute='resume_order') | list) *))
\noindent\textbf{(((proj.name)))} \textit{(((proj.start)))((* if proj.end *)) -- (((proj.end)))((* endif *))}. (((proj.description)))
\par\vspace{0.3em}
((* endfor *))

%% EDUCATION
\section*{Education}

((* for edu in education if edu.resume_visible *))
\entryheader{(((edu.institution)))}{(((edu.degree)))}{(((edu.start)))((* if edu.end *)) -- (((edu.end)))((* endif *))}{(((edu.location)))}
((* if edu.gpa or edu.notes_resume *))
{\small ((* if edu.gpa *))GPA (((edu.gpa))).((* endif *))((* if edu.notes_resume *)) (((edu.notes_resume)))((* endif *))}
((* endif *))
\vspace{0.2em}
((* endfor *))

%% TECHNICAL SKILLS — restored for ATS keyword matching.
\section*{Technical Skills}

((* for key, group in skills.items() if group.resume_visible *))
\noindent\textbf{(((group.label))):} (((group['items'] | join(', ')))).\par\vspace{0.15em}
((* endfor *))
\noindent\textbf{Human Languages:}
((* for lang in languages *))
(((lang.name))) (((lang.level)))((* if not loop.last *)), ((* else *)).((* endif *))
((* endfor *))
((* endif *))

\end{document}
