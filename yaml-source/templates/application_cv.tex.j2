% Compact application-CV entry header. Organization and role are kept on one
% line when they fit, with dates and location directly below.
\renewcommand{\entryheader}[4]{%
  \noindent\textbf{#1}\ifx&#2&\else~---~\textit{#2}\fi\par
  \vspace{-0.12em}%
  {\small\color{metagray}#3\ifx&#4&\else~\textperiodcentered~#4\fi}%
  \par\vspace{0.08em}%
}

((* macro daterange(record) -*))
(((record.start)))((* if record.end *)) -- (((record.end)))((* endif *))
((*- endmacro *))

((* macro recordlinks(record) *))
((* if record.links *))
{\small
((* for link in record.links *))
\href{(((link.href)))}{(((link.label)))}((* if not loop.last *))
\ \textperiodcentered\ ((* endif *))
((* endfor *))
}\par
((* endif *))
((* endmacro *))

((* macro experience(record) *))
\entryheader{(((record.organization)))}{(((record.role or '')))}{(((daterange(record))))}{(((record.location or '')))}
((* if record.presentation_preamble is defined *))
  ((* if record.presentation_preamble *))(((record.presentation_preamble)))\par((* endif *))
((* elif record.preamble *))
(((record.preamble)))\par
((* elif record.cv_preamble *))
(((record.cv_preamble)))\par
((* endif *))
((* if record.scope *))(((record.scope)))\par((* endif *))
((* if record.description *))(((record.description)))\par((* endif *))
((* if record.bullets and record.bullets|length == 1 *))
(((record.bullets[0])))\par
((* elif record.bullets *))
\begin{itemize}
((* for bullet in record.bullets *))
  \item (((bullet)))
((* endfor *))
\end{itemize}
((* endif *))
((* if record.notes *)){\small\textit{(((record.notes)))}}\par((* endif *))
(((recordlinks(record))))
\vspace{0.15em}
((* endmacro *))

((* macro project(record) *))
\begin{samepage}
\noindent\textbf{(((record.presentation_label or record.name)))}
{\small\color{metagray}\textit{(((daterange(record))))}}.
(((record.short_summary or record.summary or record.description)))
((* if record.bullets *))
\begin{itemize}
((* for bullet in record.bullets *))
  \item (((bullet)))
((* endfor *))
\end{itemize}
((* endif *))
\par\vspace{0.18em}
\end{samepage}
((* endmacro *))

((* macro publication(record) *))
\noindent
((* if record.title *))
\textbf{(((record.authors))).} \textit{(((record.title))).}
(((record.venue))), (((record.year)))((* if record.month *)), (((record.month)))((* endif *)).
((* else *))
\textbf{(((record.authors))).} (((record.venue))) (((record.year))).
((* endif *))
((* if record.description *)) {\small (((record.description))) }((* endif *))
\par\vspace{0.18em}
((* endmacro *))

((* macro presentation(record) *))
\noindent\textbf{(((record.authors))).}
\textit{(((record.title))).}
((* if record.kind *)) (((record.kind))),((* endif *))
(((record.venue))),((* if record.month *)) (((record.month)))((* endif *)) (((record.year))).
((* if record.status *)) (((record.status))).((* endif *))
((* if record.description *)) {\small (((record.description))) }((* endif *))
\par\vspace{0.18em}
((* endmacro *))

((* macro education(record) *))
\entryheader{(((record.institution)))}{(((record.degree)))}{(((daterange(record))))}{(((record.location or '')))}
((* if record.gpa *)){\small GPA (((record.gpa))).}((* endif *))
((* if record.notes *)){\small (((record.notes))) }((* endif *))
\vspace{0.08em}
((* endmacro *))

((* macro skill(record) *))
\noindent\textbf{(((record.presentation_label or record.label))):}
(((record['items'] | join(', ')))).\par\vspace{0.05em}
((* endmacro *))

((* macro grant(record) *))
\noindent\textbf{(((record.presentation_label or record.name)))}((* if record.kind *)), (((record.kind)))((* endif *)). (((record.year))).
((* if record.note *)) (((record.note)))((* endif *))
\par\vspace{0.15em}
((* endmacro *))

((* macro affiliation(record) *))
\entryheader{(((record.presentation_label or record.name)))}{(((record.role or '')))}{(((daterange(record))))}{}
((* if record.description *))(((record.description)))\par((* endif *))
((* endmacro *))

((* macro language(record) *))
\noindent\textbf{(((record.presentation_label or record.name))):} (((record.level))).\par
((* endmacro *))

\begin{document}

\begin{center}
  {\headerfont\LARGE\bfseries (((personal.name)))}\\[0.18em]
  ((* if variant.document_title *))
