\par
((* endif *))

((* for section in variant_sections if section.entries *))
((* if section.page_break_before *))
\newpage
((* endif *))
\section*{(((section.label)))}
((* for entry in section.entries *))
((* if entry.collection == 'experience' *))
(((experience(entry.record))))
((* elif entry.collection == 'projects' *))
(((project(entry.record))))
((* elif entry.collection == 'publications' *))
(((publication(entry.record))))
((* elif entry.collection == 'presentations' *))
(((presentation(entry.record))))
((* elif entry.collection == 'education' *))
(((education(entry.record))))
((* elif entry.collection == 'skills' *))
(((skill(entry.record))))
((* elif entry.collection == 'grants' *))
(((grant(entry.record))))
((* elif entry.collection == 'affiliations' *))
(((affiliation(entry.record))))
((* elif entry.collection == 'languages' *))
(((language(entry.record))))
((* endif *))
((* endfor *))
((* endfor *))

\end{document}
