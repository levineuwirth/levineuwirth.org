# /etc/anki-sync/server.env — read by anki-sync.service. Not secret.
SYNC_HOST=127.0.0.1
SYNC_PORT=8080
SYNC_BASE=/var/lib/anki-sync
# a full-sync upload carries a whole collection with media; the nginx
# vhost's client_max_body_size must be at least this
MAX_SYNC_PAYLOAD_MEGS=200
RUST_LOG=anki=info
