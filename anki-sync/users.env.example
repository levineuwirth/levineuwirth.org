# /etc/anki-sync/users.env — read by anki-sync.service. SECRET: root, 0600.
#
# One SYNC_USERn per account, name:hash. The hash is PHC pbkdf2-sha256 made
# by tools/anki-sync-hash from a password born in a password manager; the
# VPS never sees the password. Verified 2026-09-15 against a local server.
PASSWORDS_HASHED=1
SYNC_USER1=ln:$pbkdf2-sha256$i=600000,l=32$REPLACE$REPLACE
SYNC_USER2=nat:$pbkdf2-sha256$i=600000,l=32$REPLACE$REPLACE
